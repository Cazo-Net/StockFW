#!/bin/sh
#
# Init file for the StockFW firewall
#
# chkconfig: 2345 11 92
#
# description: Starts, stops, and lock the firewall
#
# Script Authors:
#
# config: /etc/stockfw/configuration

# Source function library.
. /etc/init.d/functions

# Source networking configuration
. /etc/sysconfig/network

# Check that networking is up.
[ ${NETWORKING} = "no" ] && exit 0

FS_CONTROL="/etc/stockfw/stockfw.sh"

[ -x $FS_CONTROL ] || exit 0
[ -s /etc/stockfw/configuration ] || exit 0

RETVAL=0

start() {
	echo -n "Starting the StockFW firewall: "
	$FS_CONTROL start > /dev/null
	RETVAL=$?
	if [ $RETVAL -eq 0 ]; then
		success
	else
		failure
	fi
	echo
	return $RETVAL
}

stop() {
	echo -n "Stopping the StockFW firewall:"
	$FS_CONTROL stop > /dev/null
	RETVAL=$?
	if [ $RETVAL -eq 0 ]; then
		success
	else
		failure
	fi
	echo
	return $RETVAL
}

lock() {
	echo -n "Locking the StockFW firewall:"
	$FS_CONTROL lock > /dev/null
	RETVAL=$?
	if [ $RETVAL -eq 0 ]; then
		success
	else
		failure
	fi
	echo
	return $RETVAL
}

# See how we were called.
case "$1" in
  start)
	start
	RETVAL=$?
	;;
  stop)
	stop
	RETVAL=$?
	;;
  restart)
	stop
	start
	RETVAL=$?
	;;
  lock)
	lock
	RETVAL=$?
	;;
  status)
	if [ -e /var/lock/subsys/stockfw -o -e /var/lock/stockfw ]; then
		echo "StockFW is running..."
	else
		echo "StockFW is stopped"
	fi
	RETVAL=$?
	;;
  *)
	echo "Usage: stockfw {start|stop|restart|lock|status}"
	exit 1
esac
exit $RETVAL
