# Build directories
build/
port/build/
# No trailing slash: a build directory may be a symbolic link.
port/build-*
port/installer/nsis/stage/
port/installer/nsis/*.exe
port/installer/linux/dist/

# IDE/Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log

# CMake (build trees only; a CMake module checked in under port/ stays
# visible, so no blanket *.cmake)
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake

# The legacy autotools tree's configure output (not built; Makefile.am
# and Makefile.in are tracked)
/Makefile
/src/Makefile
/po/Makefile
/pixmaps/Makefile
/scripts/Makefile

# Compiled objects
*.o
*.obj
*.exe
*.dll
*.lib
*.a
*.so
*.dylib

# Test outputs
test-results/
*.gcno
*.gcda
*.gcov

# Installer outputs
*.msi
*.exe
*.zip
*.tar.gz

# Local config
local.conf
*.local

# MSYS2/MinGW
.mingw/
.msys/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Node (if any)
node_modules/
npm-debug.log
yarn-error.log