#include <windows.h>

IDI_ICON1 ICON "@STOCKFW_ICON_ICO@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,4,0
 PRODUCTVERSION 1,0,4,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "StockFW Project"
            VALUE "FileDescription", "StockFW - Smart Firewall Configuration Tool"
            VALUE "FileVersion", "1.0.4"
            VALUE "InternalName", "StockFW"
            VALUE "LegalCopyright", "(C) 2000-2026 StockFW Project"
            VALUE "OriginalFilename", "StockFW.exe"
            VALUE "ProductName", "StockFW"
            VALUE "ProductVersion", "1.0.4"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
